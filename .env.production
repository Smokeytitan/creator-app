# Production Environment Variables
# DO NOT commit actual credentials to this file!
# Set these in Vercel Dashboard: Settings > Environment Variables

# These values will be injected by Vercel at build time
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
VITE_KAITO_API_KEY=your_kaito_api_key_here
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
VITE_CLAUDE_API_KEY=your_claude_api_key_here

# Vercel-managed tokens (automatically injected, do not set manually)
# VERCEL_OIDC_TOKEN - Auto-generated by Vercel CLI

# Server-side only (not prefixed with VITE_)
DEEPL_API_KEY=your_deepl_api_key_here
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
